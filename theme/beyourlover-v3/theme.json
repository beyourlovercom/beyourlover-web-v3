{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {"contentSize": "760px", "wideSize": "1440px"},
    "color": {
      "custom": false,
      "palette": [
        {"slug": "byl-brand", "name": "BYL Brand Red", "color": "#9b3749"},
        {"slug": "byl-ink", "name": "BYL Ink", "color": "#111111"},
        {"slug": "byl-soft", "name": "BYL Brand Soft", "color": "#f7ecef"},
        {"slug": "white", "name": "White", "color": "#ffffff"}
      ]
    },
    "typography": {
      "customFontSize": false,
      "fontFamilies": [
        {"slug": "poppins", "name": "Poppins", "fontFamily": "Poppins, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"}
      ]
    }
  },
  "styles": {"typography": {"fontFamily": "var(--wp--preset--font-family--poppins)"}}
}
